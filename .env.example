# ==========================================
# NOVOS SISTEMAS IPC - Configuration Template
# ==========================================
# IMPORTANTE: Copie este arquivo para .env.local e preencha com suas credenciais
# NUNCA commite .env.local - ele contém secrets!

# ==========================================
# MICROSOFT GRAPH API CONFIGURATION
# ==========================================
# Obter valores em: https://portal.azure.com
# App Registrations > Seu App > Overview

GRAPH_CLIENT_ID=seu_client_id_aqui
GRAPH_CLIENT_SECRET=seu_client_secret_aqui
GRAPH_TENANT_ID=seu_tenant_id_aqui
GRAPH_MAILBOX=seu_email@dominio.com
GRAPH_REDIRECT_URI=http://localhost:8000/index.php?page=auth/callback

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# Para Wampserver local (padrão):
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=novos_sistemas_ipc

# Para HostGator/Produção (descomentar e ajustar):
# DB_HOST=seu_host.com
# DB_USERNAME=seu_usuario
# DB_PASSWORD=sua_senha
# DB_DATABASE=seu_database

# ==========================================
# PYTHON / OLLAMA CONFIGURATION
# ==========================================
# Para desenvolvimento local (Ollama em docker/local):
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen:7b

# ==========================================
# COMO USAR
# ==========================================
# 1. Copie este arquivo:
#    cp .env.example .env.local
#
# 2. Edite .env.local com suas credenciais reais
#
# 3. O arquivo config/load-env.php carrega automaticamente
#    as variáveis quando index.php é executado
#
# 4. NUNCA faça git add .env.local!
#    Ele está no .gitignore
