# Microsoft Graph API — Credenciais (NÃO COMMITAR)
# Copie este arquivo para .env.local e preencha com suas credenciais

# Do Perito v6 (IPC-MS):
GRAPH_CLIENT_ID=***REMOVED***
GRAPH_CLIENT_SECRET=***REMOVED***
GRAPH_TENANT_ID=***REMOVED***
GRAPH_MAILBOX=financeiro@ipcms.com.br
GRAPH_REDIRECT_URI=http://localhost:8000/index.php?page=auth/callback

# Para desenvolvimento local:
# 1. Copie este arquivo: cp .env.example .env.local
# 2. Preencha com as credenciais acima
# 3. Carregue antes de iniciar o servidor PHP:
#    export $(cat .env.local | grep -v '^#' | xargs)
#    php -S localhost:8000 -t html
