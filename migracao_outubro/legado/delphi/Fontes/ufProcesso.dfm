  object qNovoLaudo: TADOQuery
    Connection = DM.ADOC_SCPG
    CursorType = ctStatic
    Parameters = <>
    SQL.Strings = (
      'SELECT extract(year from current_date) || '#39'.'#39' ||'
      
        'lpad(cast((Substring(max(tp.PRO_NUMLAUDO) FROM CHAR_LENGTH(max(t' +
        'p.PRO_NUMLAUDO))-3 FOR CHAR_LENGTH(max(tp.PRO_NUMLAUDO)))) AS in' +
        'teger)+1,4,0) AS NovoLaudo'
      'FROM TB_PROCESSO tp '
      'WHERE tp.PRO_ANO = extract(year from current_date)')
    Left = 236
    Top = 393
    object qNovoLaudoNOVOLAUDO: TStringField
      FieldName = 'NOVOLAUDO'
      Size = 11
    end
  end
  object qConsultaAutos: TADOQuery
    Connection = DM.ADOC_SCPG
    CursorType = ctStatic
    Parameters = <
      item
        Name = 'Auto'
        Attributes = [paNullable]
        DataType = ftString
        Precision = 30
        Size = 30
        Value = Null
      end
      item
        Name = 'Codigo'
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      'SELECT PRO_COD FROM tb_PROCESSO'
      'WHERE 0=0'
      'AND PRO_AUTO = :Auto'
      'AND PRO_COD not in ( :Codigo)'
      'AND (PRO_AUTO IS NOT NULL OR trim(PRO_AUTO)<>'#39#39')'
      'AND PRO_TIPO = 1')
    Left = 55
    Top = 649
    object qConsultaAutosPRO_COD: TIntegerField
      FieldName = 'PRO_COD'
    end
  end
