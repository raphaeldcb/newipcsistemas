  object qConsultaKits: TADOQuery
    Connection = DM.ADOC_SCPG
    CursorType = ctStatic
    Parameters = <>
    SQL.Strings = (
      
        'select distinct c.col_cod, c.col_nome, k.kit_denv, k.kit_rastrea' +
        'r from tb_kits k join tb_coletador c on c.col_cod=k.col_cod')
    Left = 312
    Top = 24
    object qConsultaKitsCOL_COD: TIntegerField
      FieldName = 'COL_COD'
    end
    object qConsultaKitsCOL_NOME: TStringField
      FieldName = 'COL_NOME'
      Size = 200
    end
    object qConsultaKitsKIT_DENV: TDateField
      FieldName = 'KIT_DENV'
    end
    object qConsultaKitsKIT_RASTREAR: TStringField
      FieldName = 'KIT_RASTREAR'
    end
  end
  object ds_CionsultaKits: TDataSource
    DataSet = qConsultaKits
    Left = 280
    Top = 24
  end
  object DataSource2: TDataSource
    Left = 208
    Top = 560
  end
  object qAtualizaDados: TADOQuery
    Connection = DM.ADOC_SCPG
    Parameters = <
      item
        Name = 'Registro'
        Attributes = [paNullable]
        DataType = ftString
        Precision = 20
        Size = 20
        Value = ''
      end
      item
        Name = 'DataEnvio'
        Attributes = [paNullable]
        DataType = ftDateTime
        Precision = 10
        Size = 6
        Value = 0d
      end
      item
        Name = 'Coletador'
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end>
    SQL.Strings = (
      'update tb_kits k set k.kit_rastrear = :Registro'
      'where k.kit_denv = :DataEnvio and k.col_cod = :Coletador')
    Left = 312
    Top = 72
    object StringField1: TStringField
      FieldName = 'COL_NOME'
      Size = 200
    end
    object DateField1: TDateField
      FieldName = 'KIT_DENV'
    end
    object StringField2: TStringField
      FieldName = 'KIT_RASTREAR'
    end
  end
