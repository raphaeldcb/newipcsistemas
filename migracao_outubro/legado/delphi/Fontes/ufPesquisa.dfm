      OnGetText = qSelecionaPessoasPES_SITGetText
    end
    object qSelecionaPessoasPES_DTNAS: TDateField
      FieldName = 'PES_DTNAS'
    end
    object qSelecionaPessoasPES_LCNAS: TStringField
      FieldName = 'PES_LCNAS'
      Size = 50
    end
    object qSelecionaPessoasPES_SEXO: TStringField
