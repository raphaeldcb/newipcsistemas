  object qConsultaProcedimentos: TADOQuery
    Active = True
    Connection = DM.ADOC_SCPG
    CursorType = ctStatic
    Parameters = <
      item
        Name = 'Codigo'
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = Null
      end>
    SQL.Strings = (
      
        'SELECT pa.pes_nome, p.pro_idweb , p.pro_cod, p.pro_dcol, p.pro_p' +
        'rot'
      
        'FROM tb_procedimentos P join tb_pacientes pa on pa.pes_cod=p.pes' +
        '_cod'
      'WHERE P.pro_cod = :Codigo')
    Left = 264
    Top = 48
    object qConsultaProcedimentosPES_NOME: TStringField
      FieldName = 'PES_NOME'
      Size = 60
    end
    object qConsultaProcedimentosPRO_COD: TIntegerField
      FieldName = 'PRO_COD'
    end
    object qConsultaProcedimentosPRO_DCOL: TDateField
      FieldName = 'PRO_DCOL'
    end
