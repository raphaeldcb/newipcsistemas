      object RLMemo1: TRLMemo
        Left = 2
        Top = 586
        Width = 719
        Height = 98
        Alignment = taJustify
        Behavior = [beSiteExpander]
        Font.Charset = DEFAULT_CHARSET
        Font.Color = clBlack
        Font.Height = -11
        Font.Name = 'Arial'
        Font.Style = [fsBold]
        Lines.Strings = (
          
            'Declaro, para todos os fins legais, que fui informado sobre o pr' +
            'eparo do exame e o procedimento ao qual serei submetido(a), seus' +
            ' benef'#237'cios, riscos (n'#225'usea, vomito, tontura hematoma, flebite, ' +
            'etc.), foram explicados claramente. Assim, estou ciente que o di' +
            'agn'#243'stico e a interpreta'#231#227'o dos exames s'#227'o de car'#225'ter m'#233'dico, e ' +
            'autorizo a realiza'#231#227'o do mesmo, expressando que as informa'#231#245'es f' +
            'oram devidamente prestadas pela empresa, tendo sido perfeitament' +
            'e entendidas e aceitas. As pessoas signat'#225'rias, diretamente ou p' +
            'or seus representantes legais, declaram que fornecem seus materi' +
            'ais de livre e espont'#226'nea vontade, estando cientes que os materi' +
            'ais coletados t'#234'm destina'#231#227'o espec'#237'fica para o procedimento acim' +
            'a indicado, podendo, ainda, os dados serem utilizados, sem ident' +
            'ifica'#231#227'o das pessoas, para pesquisas estat'#237'sticas e cient'#237'ficas.')
        ParentFont = False
      end
