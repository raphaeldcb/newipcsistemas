procedure TDMI.qParcelamentoPAR_SITGetText(Sender: TField; var Text: String;
  DisplayText: Boolean);
begin
	Case qParcelamentoPAR_SIT.AsInteger of
        1 : Text := 'OK';
        2 : Text := 'DEVOLVIDO';
        3 : Text := 'NÃO FORNECIDO';
    end;
end;

procedure TDMI.DataModuleCreate(Sender: TObject);
var
Arquivo: TIniFile;
CaminhoBanco, Caminho, StringConexao : String;
begin
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////
Caminho := ExtractFilePath(Application.ExeName)+'SCPG.ini';
Arquivo := TIniFile.Create(Caminho);
Try
with p_SCPG do
begin
 CaminhoBanco     := Arquivo.ReadString('DADOS','DATABASE','');
 StringConexao    := 'DRIVER=Firebird/InterBase(r) driver;UID=SYSDBA;PWD=masterkey;DBNAME=' + CaminhoBanco + ';';
 Connected        := False;
 ConnectionString := StringConexao;
 Connected        := True;
 Arquivo.Free;

 /////////////////////////////////////////////////////////////////////////////////////////////////////////////////
 ////////////////////////////////////////////////////////////////////////////////////////////////////
end;
Except
ShowMessage('Não foi possivel conectar! Nenhum servidor disponível...');
End;
////////////////////////////////////////////////////////////////////////////////////////////////////
end;

end.
