  object qSelecionaCasosMapas: TADOQuery
    Connection = DM.ADOC_SCPG
    CursorType = ctStatic
    Parameters = <
      item
        Name = 'Lote'
        DataType = ftInteger
        Precision = 10
        Size = 4
        Value = 0
      end>
    SQL.Strings = (
      
        'select mea.mpea_lote, mea.mpea_data, mec.pro_cod, mec.mpea_ord, ' +
        'mec.pes_iniciais, mec.sit_sigla'
      
        'from tb_mapa_extampli mea join tb_mapa_extampli_casos mec on mec' +
        '.mpea_lote = mea.mpea_lote'
      'where mea.mpea_lote = :Lote'
      'order by mec.pro_cod, mec.mpea_ord')
    Left = 536
    Top = 136
    object qSelecionaCasosMapasMPEA_LOTE: TIntegerField
      FieldName = 'MPEA_LOTE'
    end
    object qSelecionaCasosMapasMPEA_DATA: TDateField
      FieldName = 'MPEA_DATA'
    end
    object qSelecionaCasosMapasPRO_COD: TIntegerField
      FieldName = 'PRO_COD'
    end
    object qSelecionaCasosMapasMPEA_ORD: TIntegerField
      FieldName = 'MPEA_ORD'
    end
    object qSelecionaCasosMapasPES_INICIAIS: TStringField
      FieldName = 'PES_INICIAIS'
      Size = 10
    end
    object qSelecionaCasosMapasSIT_SIGLA: TStringField
      FieldName = 'SIT_SIGLA'
      Size = 5
    end
  end
