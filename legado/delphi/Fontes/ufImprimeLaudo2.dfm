      object RL_MEMO_COVID_PORT: TRLMemo
        Left = 20
        Top = 902
        Width = 665
        Height = 84
        Alignment = taJustify
        AutoSize = False
        Behavior = [beSiteExpander]
        Font.Charset = DEFAULT_CHARSET
        Font.Color = clBlack
        Font.Height = -9
        Font.Name = 'Arial'
        Font.Style = []
        Lines.Strings = (
          
            'OBS.: O resultado '#8220'n'#227'o detectado'#8221' na AMOSTRA pode n'#227'o excluir a ' +
            'exist'#234'ncia da doen'#231'a, podendo significar apenas que a infec'#231#227'o e' +
            'st'#225' abaixo da sensibilidade do m'#233'todo ou estar fora da janela de' +
            ' detec'#231#227'o (de 1 '#224' 7 dias). O exame de RT-PCR, segundo pesquisa, ' +
            'de Zhao J et al (2019). tem at'#233' 67% de sensibilidade. Esse exame' +
            ' pode apresentar, embora raramente, resultados falso-positivo e ' +
            'falso-negativo, que '#233' uma caracter'#237'stica do m'#233'todo. Um '#250'nico res' +
            'ultado n'#227'o detectado para SARS CoV-2 n'#227'o exclui o diagn'#243'stico da' +
            ' COVID 19. Portanto, eventualmente a coleta de m'#250'ltiplas amostra' +
            's, de locais e tempos diferentes durante a evolu'#231#227'o da doen'#231'a, p' +
            'ode ser necess'#225'ria para o diagn'#243'stico da COVID-19. ')
        ParentFont = False
      end
      object RL_MEMO_COVID_INGL: TRLMemo
        Left = 19
        Top = 990
        Width = 668
        Height = 65
        Alignment = taJustify
        AutoSize = False
        Behavior = [beSiteExpander]
        Font.Charset = DEFAULT_CHARSET
        Font.Color = clBlack
        Font.Height = -9
        Font.Name = 'Arial'
        Font.Style = []
        Lines.Strings = (
          
            'NOTE: The result '#8220'not detected'#8221' in the SAMPLE may not exclude th' +
            'e existence of the disease, which may only mean that the infecti' +
            'on is below the sensitivity of the method or being outside the d' +
            'etection window (from 1 to 7 days). The RT-PCR examination, acco' +
            'rding to research, by Zhao J. et al (2019). has up to 67% sensit' +
            'ivity. This test may present, although rarely, false-positive an' +
            'd false-negative results, which is a characteristic of the metho' +
            'd. A single undetected result for SARS CoV-2 does not exclude th' +
            'e diagnosis of COVID-19. Therefore, eventually, the collection o' +
            'f multiple samples from different sites and times during the cou' +
            'rse of the disease may be necessary for the diagnosis of COVID-1' +
            '9.')
        ParentFont = False
      end
