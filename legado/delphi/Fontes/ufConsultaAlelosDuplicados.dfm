  object qBuscaAlelos: TADOQuery
    Connection = DM.ADOC_SCPG
    CursorType = ctStatic
    Parameters = <
      item
        Name = 'valormarcador1'
        Attributes = [paNullable]
        DataType = ftString
        Precision = 30
        Size = 30
        Value = ''
      end
      item
        Name = 'ValorMarcador2'
        Attributes = [paNullable]
        DataType = ftString
        Precision = 30
        Size = 30
        Value = ''
      end
      item
        Name = 'Marcador'
        Attributes = [paNullable]
        DataType = ftString
        Precision = 200
        Size = 200
        Value = ''
      end>
    SQL.Strings = (
      'select distinct nm1_ale from tb_alelos'
      
        '         where al1_ale = :valormarcador1 and al2_ale = :ValorMar' +
        'cador2 and mar_ale = :Marcador')
    Left = 304
    Top = 152
